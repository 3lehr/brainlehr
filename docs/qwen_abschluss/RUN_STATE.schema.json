{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter_candidate_head": {"type": ["string", "null"]},
    "adapter_candidate_worktree": {"type": ["string", "null"]},
    "bootstrap_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "brainlehr_candidate_head": {"type": ["string", "null"]},
    "brainlehr_candidate_worktree": {"type": ["string", "null"]},
    "cache": {
      "additionalProperties": false,
      "properties": {
        "first_divergence": {"type": ["string", "null"]},
        "prompt_tokens": {"minimum": 0, "type": ["integer", "null"]},
        "re_prefilled_tokens": {"minimum": 0, "type": ["integer", "null"]},
        "reused_tokens": {"minimum": 0, "type": ["integer", "null"]}
      },
      "required": ["first_divergence", "prompt_tokens", "re_prefilled_tokens", "reused_tokens"],
      "type": "object"
    },
    "db_mode": {"enum": ["FROZEN", "CODEX_LIVE_VALIDATION", "RELEASED"]},
    "evidence": {
      "items": {"maxLength": 512, "type": "string"},
      "type": "array"
    },
    "gaps": {
      "items": {"maxLength": 512, "type": "string"},
      "type": "array"
    },
    "next_phase_path": {"type": "string"},
    "open_must_ids": {
      "items": {"pattern": "^BDW-[A-Z][0-9]{2,3}$", "type": "string"},
      "type": "array",
      "uniqueItems": true
    },
    "phase_id": {"enum": ["00", "01", "02", "03", "04", "05", "06"]},
    "plan_schema_version": {"const": 1},
    "previous_verdict": {"enum": ["INITIAL", "PASS", "FAIL", "CANDIDATE_PASS", "CANDIDATE_FAIL"]},
    "push_status": {"enum": ["NOT_DONE", "CODEX_PRIVATE_PUSH", "VERIFIED"]},
    "requirements_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "retrieval": {
      "additionalProperties": false,
      "properties": {
        "bge_m3": {"enum": ["ACTIVE", "INACTIVE"]},
        "coderank": {"enum": ["H0_INACTIVE", "ACTIVE", "NOT_EVALUATED"]},
        "rrf": {"enum": ["INACTIVE", "ACTIVE"]}
      },
      "required": ["bge_m3", "coderank", "rrf"],
      "type": "object"
    },
    "startprompt_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  },
  "required": [
    "adapter_candidate_head",
    "adapter_candidate_worktree",
    "bootstrap_sha256",
    "brainlehr_candidate_head",
    "brainlehr_candidate_worktree",
    "cache",
    "db_mode",
    "evidence",
    "gaps",
    "next_phase_path",
    "open_must_ids",
    "phase_id",
    "plan_schema_version",
    "previous_verdict",
    "push_status",
    "requirements_sha256",
    "retrieval",
    "startprompt_sha256"
  ],
  "type": "object"
}
