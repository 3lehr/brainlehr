{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Volumes/daten/Begod2026/brainlehr/haken/stash_guard_hook.py 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Volumes/daten/Begod2026/brainlehr/haken/agentenanker_abruf.py 2>/dev/null"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Volumes/daten/Begod2026/brainlehr/haken/existenzpruefung.py 2>/dev/null || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Volumes/daten/Begod2026/brainlehr/haken/kontextstand.py --transcript \"$CLAUDE_TRANSCRIPT_PATH\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Volumes/daten/Begod2026/brainlehr/haken/agentenanker_einspielung.py 2>/dev/null"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Volumes/daten/Begod2026/brainlehr/melder/eilmeldung_etikett.py --melder 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "python3 /Volumes/daten/Begod2026/brainlehr/melder/kantenstillstand.py 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "python3 /Volumes/daten/Begod2026/brainlehr/melder/einbettungsaussetzer.py 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "python3 /Volumes/daten/Begod2026/brainlehr/haken/kurator_taeglich.py 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "python3 /Volumes/daten/Begod2026/brainlehr/melder/zugriffsmuster.py 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
